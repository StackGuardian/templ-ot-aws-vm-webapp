{
  "type": "object",
  "required": [],
  "properties": {
    "name_prefix": {
      "title": "Name prefix",
      "type": "string",
      "description": "Prefix for all resource names",
      "default": "demo",
      "pattern": "^[a-z][a-z0-9-]{1,15}$"
    },
    "region": {
      "title": "Region",
      "type": "string",
      "description": "AWS region",
      "default": "eu-central-1"
    },
    "tags": {
      "title": "Tags",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional tags for all resources",
      "default": {}
    },
    "vpc_cidr": {
      "title": "VPC cidr",
      "type": "string",
      "description": "CIDR block of the VPC",
      "default": "10.0.0.0/16"
    },
    "instance_type": {
      "title": "Instance type",
      "type": "string",
      "description": "EC2 instance type (x86_64)",
      "default": "t3.micro"
    },
    "min_size": {
      "title": "Min size",
      "type": "number",
      "description": "Minimum number of instances",
      "default": 2
    },
    "max_size": {
      "title": "Max size",
      "type": "number",
      "description": "Maximum number of instances",
      "default": 4
    },
    "allowed_http_cidrs": {
      "title": "Allowed http cidrs",
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IPv4 CIDRs allowed to reach the load balancer. The web app is public by default.",
      "default": [
        "0.0.0.0/0"
      ]
    },
    "certificate_arn": {
      "title": "Certificate arn",
      "type": "string",
      "description": "Optional ACM certificate for HTTPS on the load balancer. Without it the app is served over HTTP only."
    },
    "deletion_protection": {
      "title": "Deletion protection",
      "type": "boolean",
      "description": "Protect the load balancer from deletion. Off by default so the demo can be destroyed.",
      "default": false
    },
    "log_retention_days": {
      "title": "Log retention days",
      "type": "number",
      "description": "Retention of load balancer access logs and VPC flow logs",
      "default": 90,
      "enum": [
        1,
        3,
        5,
        7,
        14,
        30,
        60,
        90,
        120,
        150,
        180,
        365,
        400,
        545,
        731,
        1096,
        1827,
        2192,
        2557,
        2922,
        3288,
        3653
      ]
    }
  },
  "title": "AWS Web App on VMs (Auto Scaling + ALB)"
}
